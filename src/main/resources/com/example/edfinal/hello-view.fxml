<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.ScatterChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!--
  Layout con contenedores reales. La versión anterior era un AnchorPane con
  coordenadas absolutas sobre un lienzo de 1545x881, así que en cualquier
  monitor más estrecho el borde derecho quedaba fuera. Aquí todo reparte el
  espacio disponible: las gráficas crecen, el panel lateral mantiene su ancho
  y las barras de controles bajan de línea si no caben.
-->
<BorderPane fx:id="root" minHeight="560.0" minWidth="900.0" prefHeight="881.0" prefWidth="1545.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.edfinal.HelloController">
   <stylesheets>
      <URL value="@../../../Styles/cupertino-dark.css" />
   </stylesheets>

   <top>
      <VBox spacing="6.0">
         <padding><Insets bottom="6.0" left="14.0" right="14.0" top="10.0" /></padding>

         <!-- Título y cerrar -->
         <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label opacity="0.41" text="Classification of Iris Flowers" textFill="#8a206f">
               <font><Font name="System Bold" size="28.0" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="CloseButton" mnemonicParsing="false" onAction="#closeScreen" prefHeight="30.0" prefWidth="30.0" text="X" />
         </HBox>

         <!-- Parámetros del mapa. FlowPane: si no caben, bajan de línea -->
         <FlowPane hgap="10.0" prefWrapLength="1200.0" vgap="8.0">
            <TextField fx:id="NeuronsTF" alignment="CENTER" prefHeight="34.0" prefWidth="130.0" promptText="NEURONS" />
            <TextField fx:id="EpochsTF" alignment="CENTER" prefHeight="34.0" prefWidth="130.0" promptText="EPOCHS" />
            <TextField fx:id="RadiusTF" alignment="CENTER" prefHeight="34.0" prefWidth="130.0" promptText="RADIUS" />
            <TextField fx:id="LearningRateTF" alignment="CENTER" prefHeight="34.0" prefWidth="130.0" promptText="LEARNING RATE" />
            <ComboBox fx:id="TopologyCB" prefHeight="34.0" prefWidth="150.0" />
            <Button fx:id="startButton" mnemonicParsing="false" onAction="#start" prefHeight="34.0" text="START">
               <font><Font name="System Bold" size="12.0" /></font>
            </Button>
            <Button fx:id="trainButton" mnemonicParsing="false" onAction="#train" prefHeight="34.0" text="TRAIN">
               <font><Font name="System Bold" size="12.0" /></font>
            </Button>
            <Button fx:id="mapButton" mnemonicParsing="false" onAction="#verMapa2D" prefHeight="34.0" text="2-D MAP">
               <font><Font name="System Bold" size="12.0" /></font>
            </Button>
         </FlowPane>
      </VBox>
   </top>

   <center>
      <!-- Las cuatro gráficas: cada fila y columna se reparte el espacio a partes iguales -->
      <GridPane hgap="6.0" vgap="6.0">
         <padding><Insets bottom="4.0" left="14.0" right="8.0" top="4.0" /></padding>
         <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" minWidth="240.0" percentWidth="50.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="240.0" percentWidth="50.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints minHeight="160.0" percentHeight="50.0" vgrow="ALWAYS" />
            <RowConstraints minHeight="160.0" percentHeight="50.0" vgrow="ALWAYS" />
         </rowConstraints>

         <VBox spacing="2.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <!-- Ejes elegibles: se rellenan con las variables del dataset -->
            <HBox alignment="CENTER_LEFT" spacing="4.0">
               <Label text="X" />
               <ComboBox fx:id="xVar0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
               <Label text="Y" />
               <ComboBox fx:id="yVar0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
            </HBox>
            <ScatterChart fx:id="chart0" VBox.vgrow="ALWAYS">
               <xAxis><NumberAxis side="BOTTOM" /></xAxis>
               <yAxis><NumberAxis side="LEFT" /></yAxis>
            </ScatterChart>
         </VBox>
         <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <!-- Ejes elegibles: se rellenan con las variables del dataset -->
            <HBox alignment="CENTER_LEFT" spacing="4.0">
               <Label text="X" />
               <ComboBox fx:id="xVar1" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
               <Label text="Y" />
               <ComboBox fx:id="yVar1" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
            </HBox>
            <ScatterChart fx:id="chart1" VBox.vgrow="ALWAYS">
               <xAxis><NumberAxis side="BOTTOM" /></xAxis>
               <yAxis><NumberAxis side="LEFT" /></yAxis>
            </ScatterChart>
         </VBox>
         <VBox spacing="2.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <!-- Ejes elegibles: se rellenan con las variables del dataset -->
            <HBox alignment="CENTER_LEFT" spacing="4.0">
               <Label text="X" />
               <ComboBox fx:id="xVar2" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
               <Label text="Y" />
               <ComboBox fx:id="yVar2" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
            </HBox>
            <ScatterChart fx:id="chart2" VBox.vgrow="ALWAYS">
               <xAxis><NumberAxis side="BOTTOM" /></xAxis>
               <yAxis><NumberAxis side="LEFT" /></yAxis>
            </ScatterChart>
         </VBox>
         <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <!-- Ejes elegibles: se rellenan con las variables del dataset -->
            <HBox alignment="CENTER_LEFT" spacing="4.0">
               <Label text="X" />
               <ComboBox fx:id="xVar3" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
               <Label text="Y" />
               <ComboBox fx:id="yVar3" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
            </HBox>
            <ScatterChart fx:id="chart3" VBox.vgrow="ALWAYS">
               <xAxis><NumberAxis side="BOTTOM" /></xAxis>
               <yAxis><NumberAxis side="LEFT" /></yAxis>
            </ScatterChart>
         </VBox>
      </GridPane>
   </center>

   <right>
      <!-- Panel lateral: ancho estable, alto repartido -->
      <VBox fx:id="result" maxWidth="380.0" minWidth="320.0" prefWidth="360.0" spacing="10.0">
         <padding><Insets bottom="8.0" left="6.0" right="14.0" top="4.0" /></padding>

         <Label fx:id="datasetLabel" opacity="0.55" text="Data Entry" />
         <!-- Una fila por variable del dataset; lo rellena HelloController -->
         <GridPane fx:id="entradaGrid" hgap="10.0" vgap="4.0">
            <columnConstraints>
               <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
               <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
            </columnConstraints>
         </GridPane>

         <HBox alignment="CENTER">
            <Button id="ClassButton" mnemonicParsing="false" onAction="#classify" text="Classify" />
         </HBox>

         <FlowPane hgap="8.0" vgap="6.0">
            <Button fx:id="LoadDatasetButton" mnemonicParsing="false" onAction="#loadDataset" text="Load Dataset" />
            <Button fx:id="LoadFileButton" mnemonicParsing="false" onAction="#loadFile" text="Load File" />
            <Button fx:id="LoadMapButton" mnemonicParsing="false" onAction="#loadMap" text="Load Map" />
            <Button fx:id="SaveMapButton" mnemonicParsing="false" onAction="#save" text="Save Map" />
         </FlowPane>

         <Label opacity="0.55" text="BMUs" />
         <TextArea fx:id="TextA" disable="true" editable="false" minHeight="120.0" promptText="Here you'll see the BMUs properties that the classification finds" style="-fx-control-inner-background: #1C1C1E; -fx-text-alignment: center; -fx-font-family: System;" wrapText="true" VBox.vgrow="ALWAYS" />

         <!-- Para el Iris se enseña el carrusel de fotos; para cualquier otro
              dataset, la distribución de muestras por etiqueta. -->
         <StackPane fx:id="panelInferior" maxHeight="270.0" minHeight="150.0" VBox.vgrow="SOMETIMES">
            <AnchorPane fx:id="ImgAnchor" maxHeight="270.0" maxWidth="270.0" style="-fx-border-color: gray;-fx-border-width: 2;-fx-background-radius: 100;">
               <ImageView fx:id="ImgView" fitHeight="260.0" fitWidth="260.0" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0" />
            </AnchorPane>
            <Canvas fx:id="distribucionCanvas" />
         </StackPane>
      </VBox>
   </right>

   <bottom>
      <!-- Leyenda: FlowPane para que se reordene en ventanas estrechas -->
      <!-- Una entrada por etiqueta del dataset; lo rellena HelloController -->
      <FlowPane fx:id="leyendaPane" alignment="CENTER" hgap="18.0" vgap="6.0">
         <padding><Insets bottom="10.0" left="14.0" right="14.0" top="6.0" /></padding>
      </FlowPane>
   </bottom>
</BorderPane>
